# ====================================================================
# FACE VERIFICATION PIPELINE - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your actual credentials
# ====================================================================

# 1. BRIGHT DATA API CONFIGURATION
# Obtain from Bright Data Control Panel (https://brightdata.com/) -> Account Settings -> API Tokens
BRIGHT_DATA_API_TOKEN=your_bright_data_api_token_here
BRIGHT_DATA_ENDPOINT=https://api.brightdata.com/dca

# 2. ETHEREUM SEPOLIA BLOCKCHAIN PROVIDER
# Obtain free Sepolia HTTP RPC endpoint from Infura (https://infura.io/) or Alchemy (https://alchemy.com/)
SEPOLIA_PROVIDER_URL=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_api_key_here

# 3. SMART CONTRACT ADDRESS ON SEPOLIA
# Deploy hash_registry.sol using Remix IDE (https://remix.ethereum.org) or Hardhat, then paste contract address
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# 4. ETHEREUM SEPOLIA WALLET PRIVATE KEY & PUBLIC ADDRESS
# Private key of wallet funded with Sepolia Testnet ETH (from Sepolia Faucet)
# IMPORTANT: Never commit your real mainnet private keys! Use a dedicated testnet wallet.
WALLET_PRIVATE_KEY=your_wallet_private_key_here
WALLET_ADDRESS=0xYourWalletAddressHere

# 5. ETHERSCAN EXPLORER BASE URL
ETHERSCAN_BASE_URL=https://sepolia.etherscan.io/tx/

# 6. SERPAPI KEY (Google Lens Reverse Image Search)
# Get free key (100 searches/month) from https://serpapi.com/users/sign_up
SERPAPI_KEY=your_serpapi_key_here
